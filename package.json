  "dependencies": {
    "colors": "^1.4.0",
    "minimist": "^1.2.8",
    "superagent": "^10.3.0"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.1",
    "@types/superagent": "^8.1.9",
    "@vitest/coverage-v8": "^2.1.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/piecioshka/is-responding.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "dist",
    "types",
    "index.js",
    "package.json",
    "README.md",
    "LICENSE",
    "!**/*.spec.*"
  ],
  "keywords": [
    "cli",
    "enumeration",
    "scanner",
    "test",
    "url",
    "service",
