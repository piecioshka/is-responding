{
  "name": "is-responding",
  "description": "🔨 A tool to find active endpoint use an enumeration strategy",
  "version": "1.3.0",
  "license": "MIT",
  "author": {
    "name": "Piotr Kowalski",
    "email": "piecioshka@gmail.com",
    "url": "https://piecioshka.pl/"
  },
  "scripts": {
    "clear": "rm -rf coverage/",
    "clear:all": "rm -rf node_modules/ && npm run clear",
    "check-ts": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "rm -rf dist/ types/",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepack": "npm run build",
    "postversion": "auto-changelog && git add CHANGELOG.md && git commit --amend --no-edit --no-verify && git tag -f v$npm_package_version"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "minimist": "^1.2.8",
    "superagent": "^10.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.1",
    "@types/superagent": "^8.1.9",
    "@vitest/coverage-v8": "^4.1.11",
    "auto-changelog": "^2.6.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/piecioshka/is-responding.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "types",
    "index.js",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/*.spec.*"
  ],
  "keywords": [
    "cli",
    "enumeration",
    "scanner",
    "test",
    "url",
    "service",
    "active",
    "activity",
    "respond",
    "random",
    "integer"
  ],
  "main": "index.js",
  "types": "types/index.d.ts",
  "bin": {
    "is-responding": "bin/cli.js"
  },
  "auto-changelog": {
    "commitLimit": false,
    "backfillLimit": false,
    "hideCredit": true
  }
}
